# LLM provider credentials for the clinical-panel demo.
# Copy this file to .env and fill in your values, then:
#   export $(grep -v '^#' .env | xargs)

# Required: API key for your LLM endpoint
LLM_API_KEY=your-api-key-here

# Optional: override the LLM endpoint (defaults to the internal litellm proxy)
# LLM_API_BASE=https://api.openai.com/v1
